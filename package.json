{
  "name": "mailfact-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for a Mailfact DMARC tenant. Tools return data; the client model interprets it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mailfact-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --experimental-strip-types --test test/shape.test.ts",
    "test:e2e": "tsc && node --experimental-strip-types --test test/e2e.test.ts",
    "test:e2e:live": "tsc && node --env-file=.env.e2e --experimental-strip-types --test test/live.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
